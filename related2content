#!/usr/bin/env python3

"""
related2content.py: A script that takes as stdin-input an rfc822 compliant
message with a 'multipart/related' part consisting of exactly one non-inline
'content' part (e.g. 'text/plain', 'text/html', or a 'multipart/alternative'
part) and one or more inline attachment parts (typically accumulated logos
from an email exchange), and gives as stdout-output the same message, but
with the first such 'multipart/related' part replaced by its 'content'
part, so dropping the inline attachments. Errors out if the first
'multipart/related' part in the message does not have exactly this
structure.

