details. You should have received a copy of the GNU General Public License
along with this program. If not, see <http://www.gnu.org/licenses/>.
"""

import sys
import email
import email.policy

REL = "multipart/related"


# Check whether no arguments have been given to the script (it takes none)
nargs = len(sys.argv)
if len(sys.argv) != 1:
    raise SyntaxError(f"This script takes no arguments, you gave {nargs - 1}.")

# define email policy
email_policy = email.policy.EmailPolicy(
    max_line_length=None, linesep="\r\n", refold_source="none"
)

# Read and parse the message from stdin
msg = email.message_from_bytes(sys.stdin.buffer.read(), policy=email_policy)

# Check whether the message is multipart
if not msg.is_multipart():
    raise ValueError("Message is not multipart.")

# Find the first 'multipart/related' part in the message
related = None
for part in msg.walk():
    if part.get_content_type() == REL:
        related = part
        break

# Check that there is a 'multipart/related' part in the message
if related is None:
    raise ValueError(f"Message does not contain a '{REL}' part.")

# Sort the 'multipart/related' part's immediate children into the
# non-inline 'content' part(s) and the inline attachment part(s)
content_parts = []
inline_parts = []
for part in related.iter_parts():
    if part.get_content_disposition() == "inline":
        inline_parts.append(part)
    else:
        content_parts.append(part)

# Check that the structure is exactly one 'content' part plus one or more
# inline attachment parts, and nothing else
if len(content_parts) != 1:
    raise ValueError(
        f"'{REL}' part does not have exactly one non-inline 'content' "
        f"part (found {len(content_parts)})."
    )
if len(inline_parts) < 1:
    raise ValueError(
        f"'{REL}' part does not have any inline attachment parts."
    )

content = content_parts[0]

# Replace the 'multipart/related' part by its 'content' part
related.clear_content()
for header, value in content.items():
    if header in related:
        related.replace_header(header, value)
    else:
        related.add_header(header, value)
related.set_payload(content.get_payload(), content.get_content_charset())

# Check whether no errors were found in the message (parts)
if len(msg.defects) + len(related.defects) > 0:
    raise Exception("An error occurred.")

# Send the modified message to stdout
sys.stdout.buffer.write(msg.as_bytes(policy=email_policy))
